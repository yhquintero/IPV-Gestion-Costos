# URL de la API Spring (Fase 3). Si está vacío, el BFF usa el almacén de demostración.
API_URL=
# Fuerza el almacén de demostración aunque API_URL esté definido.
MOCK_API=
# true = cookies Secure (producción HTTPS)
COOKIE_SECURE=false
# El perfil de producción del BFF se niega a arrancar sin API_URL.
APP_ENV=dev
APP_BASE_URL=http://127.0.0.1:3000
