# Copiar a .env (nunca versionar .env). Valores de ejemplo, no secretos reales.
APP_ENV=dev
APP_BASE_URL=https://localhost
API_PUBLIC_URL=https://localhost/api
DEFAULT_TIMEZONE=America/Havana
LOG_LEVEL=INFO

DB_URL=jdbc:postgresql://localhost:5432/ipvgc
DB_APP_USER=app_rw
DB_APP_PASSWORD=change-me
DB_MIGRATOR_USER=ipvgc
DB_MIGRATOR_PASSWORD=change-me
DB_AUDIT_WRITER_USER=audit_writer
DB_AUDIT_WRITER_PASSWORD=change-me
DB_REPORTING_USER=reporting_ro
DB_REPORTING_PASSWORD=change-me

# JWT / cifrado / auditoría: dejar vacío en dev hasta Fase 3.
# JWT_SIGNING_KEY_PEM_FILE=
# AUDIT_SIGNING_KEY_PEM_FILE=
# FIELD_ENCRYPTION_KEYS_FILE=

# elTOQUE: nunca en clientes ni en el repositorio. Fase 8.
# ELTOQUE_API_KEY=
ELTOQUE_API_URL=https://tasas.eltoque.com
ELTOQUE_PROVIDER_MODE=SEED
